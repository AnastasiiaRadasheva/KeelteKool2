@model KeelteKool2.Models.Students.StudentViewModel

@if (ViewBag.ViewType == "details")
{
    <h1>Info</h1>
}
else
{
    <h1>Kustuta</h1>
}

<div>
    <h4>Õpilane</h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            <span id="DD_StudentGuid">@Html.DisplayFor(model => model.Id)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="FirstName" class="col-sm-2 col-form-label">Eesnimi</label>
            <span id="DD_StudentFirstName">@Html.DisplayFor(model => model.FirstName)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="LastName" class="col-sm-2 col-form-label">Perenimi</label>
            <span id="DD_StudentLastName">@Html.DisplayFor(model => model.LastName)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Email" class="col-sm-2 col-form-label">E-post</label>
            <span id="DD_StudentEmail">@Html.DisplayFor(model => model.Email)</span>
        </div>
    </dl>
    <dl class="row">
        <div class="form-group row">
            <label asp-for="LanguageLevel" class="col-sm-2 col-form-label">Keeletase</label>
            <span id="DD_StudentLanguageLevel">@Html.DisplayFor(model => model.LanguageLevel)</span>
        </div>
    </dl>
    @if (ViewBag.ViewType == "delete")
    {
        <form asp-action="DeleteConfirmed">
            <input type="hidden" asp-for="Id" />
            <input id="DeleteDelete_BTN" type="submit" value="Kustuta" class="btn btn-danger" />

            <a id="DeleteCancel_BTN" asp-action="Index" asp-controller="Students" class="btn btn-primary">Tühista</a>
        </form>
    }
    else
    {
        <a id="DetailsUpdate_BTN" asp-action="Update" asp-controller="Students" asp-route-id="@Model.Id" class="btn btn-warning">Muuda</a>
        <a id="DetailsBack_BTN" asp-action="Index" asp-controller="Students" class="btn btn-primary">Tagasi</a>
    }
</div>
