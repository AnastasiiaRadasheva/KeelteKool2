@model KeelteKool2.Models.Lecturers.LecturerCreateUpdateViewModel

@* eraldame update ja create *@
@if (Model.Id.HasValue)
{
    <h1>Muuda õppejõudu</h1>
}
else
{
    <h1>Lisa uus õppejõud</h1>
}

<div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />

        <div class="form-group">
            <label asp-for="FirstName" class="control-label"></label>
            <input id="CU_Lecturer_FirstName" asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="control-label"></label>
            <input id="CU_Lecturer_LastName" asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Qualifications" class="control-label"></label>
            <textarea id="CU_Lecturer_Qualifications" asp-for="Qualifications" class="form-control"></textarea>
            <span asp-validation-for="Qualifications" class="text-danger"></span>
        </div>

        @if (Model.Id.HasValue)
        {
            <input id="CU_Update_BTN" asp-action="Update" asp-controller="Lecturers" type="submit" value="Muuda" class="btn btn-success" />
        }
        else
        {
            <input id="CU_Create_BTN" asp-action="Create" asp-controller="Lecturers" type="submit" value="Lisa" class="btn btn-success" />
        }
        <a id="CU_Cancel_BTN" asp-action="Index" asp-controller="Lecturers" class="btn btn-secondary">Tagasi</a>
    </form>
</div>
