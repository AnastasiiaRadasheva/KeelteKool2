@model KeelteKool2.Models.LanguageCourses.LanguageCourseViewModel

<h1>Kas soovid kustutada?</h1>

<dl class="row">
    <dt class="col-sm-2">Nimetus</dt>
    <dd class="col-sm-10">@Model.Nimetus</dd>

    <dt class="col-sm-2">Keel</dt>
    <dd class="col-sm-10">@Model.Keel</dd>

    <dt class="col-sm-2">Tase</dt>
    <dd class="col-sm-10">@Model.Tase</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Kustuta</button>
    <a asp-action="Index" class="btn btn-primary">Tagasi</a>
</form>