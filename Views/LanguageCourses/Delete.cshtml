@model KeelteKool2.Models.LanguageCourses.LanguageCourseViewModel
@{
    ViewBag.Title = "Kustuta";
}

<h1>Kas soovid selle kursuse kustutada?</h1>

<dl class="row">
    <dt class="col-sm-2">Nimetus</dt>
    <dd id="DD_LanguageCourseTase" class="col-sm-10">@Model.Nimetus</dd>

    <dt class="col-sm-2">Keel</dt>
    <dd id="DD_LanguageCourseTase" class="col-sm-10">@Model.Keel</dd>

    <dt class="col-sm-2">Tase</dt>
    <dd id="DD_LanguageCourseTase" class="col-sm-10">@Model.Tase</dd>

    <dt class="col-sm-2">Kirjeldus</dt>
    <dd id="DD_LanguageCourseTase" class="col-sm-10">@Model.Kirjeldus</dd>
</dl>

<form asp-action="Delete" asp-controller="LanguageCourses" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Kustuta</button>
    <a asp-action="Index" class="btn btn-primary">Tagasi</a>
</form>