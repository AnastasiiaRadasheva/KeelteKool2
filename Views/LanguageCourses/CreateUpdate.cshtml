@model KeelteKool2.Models.LanguageCourses.LanguageCourseViewModel
@{
    ViewBag.Title = Model.Id.HasValue ? "Muuda keelekursust" : "Lisa keelekursus";
}

<h1>@ViewBag.Title</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Nimetus" class="form-label"></label>
        <input id="CU_LanguageCourse_Nimetus" asp-for="Nimetus" class="form-control" />
        <span asp-validation-for="Nimetus" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Keel" class="form-label"></label>
        <input id="CU_LanguageCourse_Keel" asp-for="Keel" class="form-control" />
        <span asp-validation-for="Keel" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tase" class="form-label"></label>
        <input id="CU_LanguageCourse_Tase" asp-for="Tase" class="form-control" />
        <span asp-validation-for="Tase" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Kirjeldus" class="form-label"></label>
        <textarea id="CU_LanguageCourse_Kirjeldus" asp-for="Kirjeldus" class="form-control"></textarea>
        <span asp-validation-for="Kirjeldus" class="text-danger"></span>
    </div>

    @if (Model.Id.HasValue)
    {
        <input id="CU_Update_BTN" asp-action="Update" asp-controller="LanguageCourses" type="submit" value="Muuda" class="btn btn-warning" />
    }
    else
    {
        <input id="CU_Create_BTN" asp-action="Create" asp-controller="LanguageCourses" type="submit" value="Lisa" class="btn btn-success" />
    }
    <a id="CU_Back_BTN" asp-action="Index" asp-controller="LanguageCourses" class="btn btn-primary">Tagasi</a>
</form>
