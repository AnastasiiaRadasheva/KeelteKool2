@model KeelteKool2.Models.LanguageCourses.LanguageCourseCreateUpdateViewModel

@* separate update create *@
@if (Model.Id.HasValue)
{
    <h1>Muuda kursust</h1>
}
else
{
    <h1>Loo uus kursus</h1>
}

<div>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />
        <input asp-for="ModifiedBy" type="hidden" />

        <div class="form-group">
            <label asp-for="Nimetus" class="control-label"></label>
            <input id="CU_LanguageCourse_Nimetus" asp-for="Nimetus" class="form-control" />
            <span asp-validation-for="Nimetus" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Keel" class="control-label"></label>
            <input id="CU_LanguageCourse_Keel" asp-for="Keel" class="form-control" />
            <span asp-validation-for="Keel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Tase" class="control-label"></label>
            <input id="CU_LanguageCourse_Tase" asp-for="Tase" class="form-control" />
            <span asp-validation-for="Tase" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Kirjeldus" class="control-label"></label>
            <textarea id="CU_LanguageCourse_Kirjeldus" asp-for="Kirjeldus" class="form-control"></textarea>
            <span asp-validation-for="Kirjeldus" class="text-danger"></span>
        </div>

        @if (Model.Id.HasValue)
        {
            <input id="CU_Update_BTN" asp-action="Update" asp-controller="LanguageCourses" type="submit" value="Muuda" class="btn btn-success" />
        }
        else
        {
            <input id="CU_Create_BTN" asp-action="Create" asp-controller="LanguageCourses" type="submit" value="Lisa" class="btn btn-success" />
        }
        <a id="CU_Cancel_BTN" asp-action="Index" asp-controller="LanguageCourses" class="btn btn-secondary">Tagasi</a>
    </form>
</div>
