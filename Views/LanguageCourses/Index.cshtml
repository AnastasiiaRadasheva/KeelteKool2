@model IEnumerable<KeelteKool2.Models.LanguageCourses.LanguageCourseViewModel>
@{
    int rownumber = 1;
    ViewBag.Title = "Keelekursused";
}
@*Later check for role of the user, hide this button if not admin or teacher*@
<div>
    <a asp-action="Create" asp-controller="LanguageCourses" class="btn btn-dark">Lisa uus keelekursus</a>
</div>

<div class="h1">
    Keelekursused
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Nimetus</th>
            <th scope="col">Õpetatav keel</th>
            <th scope="col">Tase</th>
            <th scope="col">Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@rownumber</td>
                <td>@course.Nimetus</td>
                <td>@course.Keel</td>
                <td>@course.Tase</td>
                <td>
                    <a asp-action="Details" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-secondary">Andmed</a>
                    <a asp-action="Update" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-warning">Muuda</a>
                    <a asp-action="Delete" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-danger">Kustuta</a>
                </td>
            </tr>
            rownumber++;
        }
    </tbody>
</table>